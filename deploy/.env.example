# Copiar a .env en la carpeta del stack (variables del docker-compose.yml).
# Las variables de la API (DB_*, JWT_SECRET, OPENAI_*, ...) NO van aca:
# van en api.env, en la misma carpeta.

# --- Produccion: /opt/docker/intranet/.env ---
# Puerto del servidor donde se publica la intranet (front + /api/)
INTRANET_PORT=80

# Fijar una version puntual (sha del commit) en vez de :latest.
# Ojo: con esto fijado, los deploys automaticos no cambian ese servicio.
# API_TAG=
# WEB_TAG=

# --- Prueba: /opt/docker/intranet-dev/.env ---
# STACK_NAME=intranet-dev
# INTRANET_PORT=7723
# API_TAG=dev
# WEB_TAG=dev
